<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
	<extension
		point="org.eclipse.ui.propertyPages">
		<page
			class="org.enterprisedomain.classmaker.ui.ContributionPropertyPage"
			id="org.enterprisedomain.classmaker.ui.propertyPage"
			name="Domain Tools">
			<enabledWhen>
				<adapt
					type="org.enterprisedomain.classmaker.Contribution">
				</adapt>
			</enabledWhen>
		</page>
	</extension>
	<extension
		point="org.eclipse.ui.commands">
		<command
			id="org.enterprisedomain.ui.command.make"
			name="Make">
		</command>
	</extension>
	<extension
		point="org.eclipse.ui.handlers">
		<handler
			class="org.enterprisedomain.classmaker.ui.MakeHandler"
			commandId="org.enterprisedomain.ui.command.make">
			<activeWhen>
				<with
					variable="activeMenuSelection">
					<iterate
						ifEmpty="false">
						<or>
							<adapt
								type="org.eclipse.core.resources.IProject">
								<test
									property="org.eclipse.core.resources.projectNature"
									value="org.enterprisedomain.classmaker.contributionProjectNature">
								</test>
							</adapt>
							<adapt
								type="org.enterprisedomain.classmaker.Contribution">
							</adapt>
						</or>
					</iterate>
				</with>
			</activeWhen>
		</handler>
	</extension>
	<extension
		point="org.eclipse.ui.menus">
		<menuContribution
			allPopups="false"
			locationURI="popup:org.eclipse.ui.popup.any?after=additions">
			<command
				commandId="org.enterprisedomain.ui.command.make"
				style="push">
				<visibleWhen>
					<with
						variable="activeMenuSelection">
						<iterate
							ifEmpty="false">
							<or>
								<adapt
									type="org.eclipse.core.resources.IProject">
									<test
										property="org.eclipse.core.resources.projectNature"
										value="org.enterprisedomain.classmaker.contributionProjectNature">
									</test>
								</adapt>
								<adapt
									type="org.enterprisedomain.classmaker.Contribution">
								</adapt>
							</or>
						</iterate>
					</with>
				</visibleWhen>
			</command>
		</menuContribution>
	</extension>
</plugin>
